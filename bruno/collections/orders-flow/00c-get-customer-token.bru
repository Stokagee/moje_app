meta {
  name: 00c - Get Customer Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/test-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "test_customer",
    "role": "user",
    "user_id": 100,
    "scopes": "orders:read"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar('customer_token', res.body.access_token);
  }
}
