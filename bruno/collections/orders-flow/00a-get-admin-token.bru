meta {
  name: 00a - Get Admin Token
  type: http
  seq: 1
}

docs {
  Ziska admin token pro testovani.
}

post {
  url: {{base_url}}/auth/test-token
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "test_admin",
    "role": "admin",
    "user_id": 1,
    "scopes": "orders:read orders:write orders:admin"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar('admin_token', res.body.access_token);
  }
}
